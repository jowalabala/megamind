# Postgres (docker compose up -d postgres)
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/mastermind
DATABASE_URL=postgres://mm_app:mm_app_dev_password@localhost:5432/mastermind

# WorkOS (https://dashboard.workos.com -> API Keys). Redirect URI must be registered in WorkOS.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=   # at least 32 random characters: openssl rand -base64 32
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback

# Bedrock (Claude). Uses the standard AWS credential chain.
AWS_REGION=us-east-1
MM_LLM_MODEL_STRONG=anthropic.claude-sonnet-5-5
MM_LLM_MODEL_FAST=anthropic.claude-haiku-5-5

# API + worker (apps/api, apps/worker)
MM_API_URL=http://localhost:4000
# Raw payloads go to S3 in AWS (MM_BRONZE_BUCKET); locally to .data/bronze (git-ignored).
# Keys per-tenant pseudonyms. At least 32 random characters: openssl rand -base64 32
MM_PSEUDONYM_SECRET=
# Set to "on" to add AWS Comprehend PII detection (names, addresses) in the worker.
MM_PII_COMPREHEND=off

# Lake. Locally: newline-delimited JSON under .data/lake (git-ignored).
# In AWS (set by the CDK app stack): the Firehose stream and S3 table bucket.
MM_LAKE_DIR=../../.data/lake
# MM_STAGE=dev
# MM_LAKE_FIREHOSE_STREAM=mastermind-dev-lake
# MM_LAKE_TABLE_BUCKET_ARN=arn:aws:s3tables:us-east-1:<account>:bucket/mastermind-dev-lake

# Categorization: set to "off" to skip Claude and use pack rules only (no Bedrock needed).
MM_LLM_CATEGORIZE=off

# GitHub App (see README "GitHub App"). Web: OAuth flows. API: webhooks. Worker: GitHub calls.
MM_GITHUB_APP_SLUG=
MM_GITHUB_CLIENT_ID=
MM_GITHUB_CLIENT_SECRET=
MM_GITHUB_WEBHOOK_SECRET=
MM_GITHUB_APP_ID=
# PEM private key; newlines may be written as \n.
MM_GITHUB_PRIVATE_KEY=

# Real-time gateway (apps/gateway). The API signs 5-minute WebSocket tokens with the shared
# secret (32+ characters) and tells the bridge where to connect.
MM_GATEWAY_SECRET=
MM_GATEWAY_URL=ws://localhost:4200
# Set to "off" to stop the bridge from showing up live (presence).
# MM_PRESENCE=off
