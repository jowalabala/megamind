# Postgres (docker compose up -d postgres)
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/mastermind
DATABASE_URL=postgres://mm_app:mm_app_dev_password@localhost:5432/mastermind

# WorkOS (https://dashboard.workos.com -> API Keys). Redirect URI must be registered in WorkOS.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=   # at least 32 random characters: openssl rand -base64 32
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback

# Bedrock (Claude). Uses the standard AWS credential chain.
AWS_REGION=us-east-1
MM_LLM_MODEL_STRONG=anthropic.claude-sonnet-5-5
MM_LLM_MODEL_FAST=anthropic.claude-haiku-5-5
