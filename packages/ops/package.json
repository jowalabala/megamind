{
  "name": "@mm/ops",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "purge-tenant": "tsx src/cli/purge-tenant.ts",
    "restore-drill": "tsx src/cli/restore-drill.ts",
    "build": "node ../../scripts/bundle.mjs src/cli/purge-tenant.ts dist/purge-tenant.js && node ../../scripts/bundle.mjs src/cli/restore-drill.ts dist/restore-drill.js"
  },
  "dependencies": {
    "@aws-sdk/client-athena": "^3.1160.0",
    "@aws-sdk/client-iam": "^3.1160.0",
    "@aws-sdk/client-kms": "^3.1160.0",
    "@aws-sdk/client-rds": "^3.1161.0",
    "@aws-sdk/client-s3": "^3.1160.0",
    "@aws-sdk/client-s3tables": "^3.1160.0",
    "@aws-sdk/client-secrets-manager": "^3.1161.0",
    "@mm/audit": "workspace:*",
    "@mm/db": "workspace:*",
    "@mm/hubspot": "workspace:*",
    "@mm/ingest": "workspace:*",
    "@mm/lake": "workspace:*",
    "@mm/slack": "workspace:*",
    "@mm/vault": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.20.0",
    "vitest": "^5.1.0"
  }
}
